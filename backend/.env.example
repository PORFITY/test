# Токен, который должно присылать приложение (Authorization: Bearer ...). Пусто = без авторизации (только для локальной разработки!)
API_TOKEN=
# Токен администратора для загрузки каталогов (/v1/catalog/import)
ADMIN_TOKEN=
# Ключ Anthropic API для AI-помощника (хранится ТОЛЬКО на сервере). Без него работают локальные команды.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Идентификация перед OpenStreetMap/Open Food Facts (правила использования их API): укажите приложение и контакт
USER_AGENT=MealPlannerBackend/1.0 (contact: you@example.com)
DB_PATH=data/backend.db
